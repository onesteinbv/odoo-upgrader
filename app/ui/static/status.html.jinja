<!doctype html>
<html lang="en">
    <head>
        <title>Upgrade Status</title>
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/bulma.min.css"
        >
        <script src="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.7.2/js/all.min.js"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.7.2/css/fontawesome.min.css" rel="stylesheet">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="color-scheme" content="light dark">
    </head>
    <body>
        <script type="module">
            import { LitElement, html } from 'https://esm.sh/lit@3.1.2';	
            import { ifDefined } from 'https://esm.sh/lit@3.1.2/directives/if-defined.js';

            class UpgradeProgress extends LitElement {
                static properties = {
                    progress: {type: Number},
                    state: {type: String},
                    jobId: {type: String},
                    job: {state: true, attribute: false},
                    resumeModalActive: { type: Boolean }
                }

                constructor() {
                    super();
                    this.job = {};
                    this.eventSource = null;
                }

                _onResumeClicked(e) {
                    this.resumeModalActive = true;
                }

                _onResumeConfirmClicked() {
                    this._resumeJob();
                    this.resumeModalActive = false;
                }

                _onCloseModalClicked(e) {
                    this.resumeModalActive = false
                }

                connectedCallback() {
                    super.connectedCallback();
                    this.eventSource = new EventSource(`/api/v1/events`);
                    this.eventSource.addEventListener("job:updated", this.onJobUpdated.bind(this));
                    
                    window.addEventListener("beforeunload", this._handleUnload);
                }
                
                firstUpdated() {
                    this.job = { 
                        progress: this.progress, 
                        id: this.jobId,
                        state: this.state
                    };
                    this.getJob().then(job => this.job = job);
                }

                disconnectedCallback() {
                    window.removeEventListener("beforeunload", this._handleUnload);
                    if (this.eventSource) {
                        this.eventSource.close();
                    }
                    super.disconnectedCallback();
                }

                _handleUnload() {
                    if (this.eventSource) {
                        this.eventSource.close();
                    }
                }

                onJobUpdated(e) {
                    const eventData = JSON.parse(e.data);
                    if (this.jobId != eventData.id) return;
                    
                    this.job = { ...this.job, ...eventData };
                }

                async getJob() {
                    const res = await fetch(`/api/v1/jobs/${this.jobId}`);
                    return res.json();
                }

                async _resumeJob() {
                    const res = await fetch(`/api/v1/jobs/${this.jobId}/resume`, { method: "POST"});
                    return res.json();
                }

                createRenderRoot() {
                    return this;
                }

                onDownloadClicked() {
                    const withArtifacts = this.job.steps.filter(s => s.artifacts.length);
                    const stepId = withArtifacts[withArtifacts.length - 1].id;
                    window.open(`/api/v1/jobs/${this.job.id}/${stepId}/download/result`);
                }
                
                render() {
                    return html`
                        <div class="is-flex is-align-items-center">
                            <div class="is-flex-grow-1"><upgrade-progress-bar .job=${this.job}></upgrade-progress-bar></div>
                            <div><state-icon .state=${this.job.state}></state-icon></div>
                        </div>
                        ${this.job.state == "succeeded" && html`
                            <div class="notification is-success mt-4">
                                <i class="fas fa-check"></i> <b>Upgrade succeeded!</b> Click the button below to download the upgraded database.
                            </div>
                            <button class="button is-large" @click="${this.onDownloadClicked}">
                                <span class="icon">
                                    <i class="fas fa-download" aria-hidden="true"></i>
                                </span>
                            </button>
                        ` || ""}
                        ${this.job.state == "failed" && html`
                            <div class="notification is-danger mt-4">
                                <i class="fas fa-heart-crack"></i> <b>Upgrade failed</b>
                            </div>
                        ` || ""}
                        ${this.job.annotations && "odoo-upgrader/deployment-url" in this.job.annotations && html`
                            <a class="button is-large" href="${this.job.annotations["odoo-upgrader/deployment-url"]}">
                                <span class="icon">
                                    <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                                </span>
                            </a>
                        ` || ""}
                        ${this.job.suspended && html`
                            <button class="button is-large" @click="${this._onResumeClicked}">
                                <span class="icon">
                                    <i class="fa fa-play"></i>
                                </span>
                            </button>
                        ` || ""}
                        
                        <div class="modal ${this.resumeModalActive ? "is-active" : ""}">
                            <div class="modal-background"></div>
                            <div class="modal-card">
                                <section class="modal-card-body">
                                    Are you sure you want to <b>resume</b>?
                                </section>
                                <footer class="modal-card-foot">
                                    <div class="buttons">
                                        <button class="button is-success" @click="${this._onResumeConfirmClicked}">Yes, continue</button>
                                        <button @click="${this._onCloseModalClicked}" class="button">Cancel</button>
                                    </div>
                                </footer>
                            </div>
                            <button @click="${this._onCloseModalClicked}" class="modal-close is-large" aria-label="close"></button>
                        </div>
                    `
                }
            }

            class UpgradeProgressBar extends LitElement {
                static properties = {
                    job: {state: true}
                }

                createRenderRoot() {
                    return this;
                }

                render() {
                    const extraClasses = this.getStateClasses();
                    let progress = this.job.progress;
                    if (this.job.state == "failed") {
                        progress = 1;
                    }

                    if (progress == 0) {
                        progress = 0.01;
                    }

                    return html`
                        <progress class="progress is-large ${extraClasses}" value="${ifDefined(["pending", "dispatched"].includes(this.job.state) ? undefined : progress)}" max="1"></progress>
                    `;
                }

                getStateClasses() {
                    return this.job.state == "pending" && "is-info" 
                        || this.job.state == "dispatched" && "is-info"
                        || this.job.state == "in_progress" && "is-info"
                        || this.job.state == "failed" && "is-danger"
                        || this.job.state == "succeeded" && "is-success"
                        || this.job.state == "suspended" && "is-warning" 
                        || ""
                }
            };

            class StateIcon extends LitElement {
                static properties = {
                    state: { type: String, state: true }
                }

                createRenderRoot() {
                    return this;
                }

                render() {
                    return html`
                        <span class="icon is-large">
                            ${this.state == "pending" && html`
                                <i class="fas fa-circle has-text-info" aria-hidden="true"></i>
                            ` || this.state == "dispatched" && html`
                                <i class="fas fa-circle has-text-info" aria-hidden="true"></i>
                            ` || this.state == "in_progress" && html`
                                <i class="fas fa-circle-notch fa-spin has-text-info" aria-hidden="true"></i>
                            ` || this.state == "failed" && html`
                                <i class="fas fa-circle has-text-danger" aria-hidden="true"></i>
                            ` || this.state == "succeeded" && html`
                                <i class="fas fa-circle has-text-success" aria-hidden="true"></i>
                            ` || this.state == "suspended" && html`
                                <i class="fas fa-pause has-text-warning" aria-hidden="true"></i>
                            `}
                        </span>
                    `;
                }
            }


            customElements.define("state-icon", StateIcon);
            customElements.define("upgrade-progress", UpgradeProgress);
            customElements.define("upgrade-progress-bar", UpgradeProgressBar);
        </script>
        <section class="hero is-dark">
            <div class="hero-body has-text-centered">
                <p class="title">Upgrade Status</p>
            </div>
        </section>
        <section class="section">
            <div class="container has-text-centered">
                <upgrade-progress jobId="{{ job.id }}" progress="{{ job.progress }}"></upgrade-progress>
            </div>
        </section>
    </body>
</html>
